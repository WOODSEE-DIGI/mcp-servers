{
  "install_root": "~/GitHub/AI-ML-Agents",
  "servers": [
    {
      "name": "ai-context-bridge",
      "repo": "https://github.com/WOODSEE-DIGI/ai-context-bridge.git",
      "local_path": "~/GitHub/AI-ML-Agents/ai-context-bridge",
      "command": "node",
      "args": ["~/GitHub/AI-ML-Agents/ai-context-bridge/server.js"],
      "build": ["npm install"]
    },
    {
      "name": "playwright-mcp",
      "repo": "https://github.com/WOODSEE-DIGI/playwright-mcp.git",
      "local_path": "~/GitHub/AI-ML-Agents/playwright-mcp",
      "command": "node",
      "args": [
        "~/GitHub/AI-ML-Agents/playwright-mcp/packages/playwright-mcp/cli.js",
        "--headless",
        "--caps=network,storage,testing,pdf,vision,devtools"
      ],
      "build": ["npm install"],
      "extras": [
        "cd packages/playwright-mcp && npx playwright install chromium"
      ]
    },
    {
      "name": "firecrawl-mcp",
      "repo": "https://github.com/WOODSEE-DIGI/firecrawl-mcp-server.git",
      "local_path": "~/GitHub/AI-ML-Agents/firecrawl-mcp-server",
      "command": "node",
      "args": ["~/GitHub/AI-ML-Agents/firecrawl-mcp-server/dist/index.js"],
      "build": ["npm install", "npm run build"],
      "env": {
        "FIRECRAWL_API_URL": "http://localhost:3002"
      }
    },
    {
      "name": "webclaw-mcp",
      "repo": "https://github.com/WOODSEE-DIGI/webclaw.git",
      "local_path": "~/GitHub/AI-ML-Agents/webclaw",
      "command": "~/GitHub/AI-ML-Agents/webclaw/target/release/webclaw-mcp",
      "args": [],
      "build": ["cargo build -p webclaw-mcp --release"]
    },
    {
      "name": "crawlkit-mcp",
      "repo": "https://github.com/WOODSEE-DIGI/crawlkit-mcp.git",
      "local_path": "~/GitHub/AI-ML-Agents/crawlkit-mcp",
      "command": "node",
      "args": ["~/GitHub/AI-ML-Agents/crawlkit-mcp/server.js"],
      "build": ["npm install"],
      "env": {
        "CRAWLKIT_BASE_URL": "http://localhost:8088",
        "CRAWLKIT_MASTER_KEY": "local-master-key"
      }
    },
    {
      "name": "read-website-fast",
      "repo": "https://github.com/WOODSEE-DIGI/mcp-read-website-fast.git",
      "local_path": "~/GitHub/AI-ML-Agents/mcp-read-website-fast",
      "command": "node",
      "args": ["~/GitHub/AI-ML-Agents/mcp-read-website-fast/dist/serve-restart.js"],
      "build": ["npm install", "npm run build"]
    },
    {
      "name": "whatsapp-mcp",
      "repo": "https://github.com/WOODSEE-DIGI/whatsapp-mcp.git",
      "local_path": "~/GitHub/AI-ML-Agents/whatsapp-mcp",
      "command": "uv",
      "args": [
        "--directory",
        "~/GitHub/AI-ML-Agents/whatsapp-mcp/whatsapp-mcp-server",
        "run",
        "main.py"
      ],
      "build": []
    },
    {
      "name": "qwen3-mcp-server",
      "repo": "https://github.com/WOODSEE-DIGI/qwen3-mcp-server.git",
      "local_path": "~/qwen3-mcp-server",
      "command": "~/qwen3-mcp-server/venv/bin/python",
      "args": ["~/qwen3-mcp-server/src/main.py"],
      "build": ["python3 -m venv venv", "venv/bin/pip install -r requirements.txt"]
    },
    {
      "name": "swift-terminals",
      "repo": "https://github.com/WOODSEE-DIGI/Swift-terminals.git",
      "local_path": "~/GitHub/AI-ML-Agents/Swift-terminals",
      "command": "node",
      "args": ["~/GitHub/AI-ML-Agents/Swift-terminals/dist/index.js"],
      "build": ["npm install", "npm run build"]
    },
    {
      "name": "xcodebuildmcp",
      "repo": "https://github.com/WOODSEE-DIGI/XcodeBuildMCP.git",
      "local_path": "~/GitHub/AI-ML-Agents/XcodeBuildMCP",
      "command": "node",
      "args": ["~/GitHub/AI-ML-Agents/XcodeBuildMCP/build/cli.js", "mcp"],
      "build": ["npm install", "npm run build"],
      "note": "Requires Xcode (install from Mac App Store or Apple Developer)"
    }
  ],
  "backends": [
    {
      "name": "firecrawl-backend",
      "repo": "https://github.com/firecrawl/firecrawl.git",
      "local_path": "~/GitHub/AI-ML-Agents/firecrawl",
      "needs": ["docker"],
      "setup": [
        "test -f .env || cp .env.example .env || printf 'PORT=3002\nHOST=0.0.0.0\nUSE_DB_AUTHENTICATION=false\nBULL_AUTH_KEY=CHANGEME\n' > .env",
        "docker compose build"
      ],
      "start": ["docker compose up -d"],
      "health_url": "http://localhost:3002"
    },
    {
      "name": "crawlkit-backend",
      "repo": "https://github.com/WOODSEE-DIGI/crawlkit.git",
      "local_path": "~/GitHub/AI-ML-Agents/crawlkit",
      "needs": ["docker"],
      "setup": [],
      "start": [
        "docker build -t crawlkit-local .",
        "docker rm -f crawlkit-local 2>/dev/null || true",
        "docker run -d --name crawlkit-local -p 8088:8088 -e PORT=8088 -e CRAWLKIT_MASTER_KEY=local-master-key crawlkit-local"
      ],
      "health_url": "http://localhost:8088"
    },
    {
      "name": "ollama",
      "needs": [],
      "setup": [
        "command -v ollama >/dev/null || brew install ollama || (curl -fsSL https://ollama.com/install.sh | sh)"
      ],
      "start": [
        "(ollama serve > ~/.ollama/serve.log 2>&1 &)",
        "sleep 2",
        "ollama pull qwen3:8b || true"
      ],
      "health_url": "http://localhost:11434/api/version"
    },
    {
      "name": "whatsapp-bridge",
      "repo": "https://github.com/WOODSEE-DIGI/whatsapp-mcp.git",
      "local_path": "~/GitHub/AI-ML-Agents/whatsapp-mcp",
      "needs": ["go"],
      "setup": ["cd whatsapp-bridge && go build -o whatsapp-bridge main.go"],
      "start": ["cd whatsapp-bridge && ./whatsapp-bridge"],
      "interactive": true,
      "note": "Scan the QR code with WhatsApp mobile app to authenticate"
    }
  ]
}
